        default y
    
    config PAW3222
        default y
    
    config INPUT
        default y
    
    config SPI
        default y

config RGBLED_WIDGET_BATTERY_LEVEL_HIGH
    default 30

config RGBLED_WIDGET_BATTERY_LEVEL_CRITICAL
    default 10

